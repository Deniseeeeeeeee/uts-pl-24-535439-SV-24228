# Salin file ini menjadi .env (copy .env.example .env), lalu isi nilainya.
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Hindari karakter $ dan # di dalam password.

# Hasil dari: php artisan key:generate --show   (jalankan di folder backend)
APP_KEY=base64:GANTI_DENGAN_HASIL_KEY_GENERATE

DB_DATABASE=movie_db
DB_USERNAME=movie_user
DB_PASSWORD=ganti_password_ini
DB_ROOT_PASSWORD=ganti_password_root_ini
